# ═══════════════════════════════════════════════════════════════
#  SamriddhiSetu – Monorepo .gitignore
#  React (Vite) client  +  Express / Node.js server
# ═══════════════════════════════════════════════════════════════

# ─── Node Modules ───────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Environment Variables (NEVER commit secrets) ───────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
server/.env
server/.env.*
client/.env
client/.env.*
!**/.env.example       # always allow example files

# ─── Build / Compile Outputs ────────────────────────────────────
dist/
dist-ssr/
build/
out/
client/dist/
client/dist-ssr/
client/build/
server/dist/
server/build/

# ─── Vite / Rollup / ESBuild Cache ──────────────────────────────
client/.vite/
client/.cache/
.vite/
*.local

# ─── TypeScript compiled output ─────────────────────────────────
*.js.map
*.d.ts.map

# ─── Logs ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Testing / Coverage ─────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/

# ─── Package Manager Artifacts ──────────────────────────────────
.npm/
.pnp
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ─── OS Generated Files ─────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── Editor / IDE ───────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ─── Security / Credentials ─────────────────────────────────────
*.pem
*.p12
*.key
*.cert
*.crt
secrets/
credentials/

# ─── Runtime / Misc ─────────────────────────────────────────────
.yarn-integrity
*.pid
*.seed
*.pid.lock
.node_repl_history
.cache/
tmp/
temp/
